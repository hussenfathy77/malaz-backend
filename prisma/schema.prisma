generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // أو حسب قاعدة البيانات المستخدمة
  url      = env("DATABASE_URL")
}

// ================= Enums =================

enum Role {
  PATIENT
  DOCTOR
  CAREGIVER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CaregiverStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum CircleRole {
  ADMIN
  MEMBER
}

// ================= Models =================

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String
  full_name          String
  profile_pic        String?             // تمت الإضافة: الصورة الشخصية
  role               Role
  account_status     AccountStatus       @default(ACTIVE)
  preferred_language String              @default("ar")
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  // Relations
  doctor_profile     Doctor?
  patient_profile    Patient?
  notifications      Notification[]
  circle_messages    SafeCircleMessage[]
  safe_circles       SafeCircleMember[]  // تمت الإضافة: الربط مع دوائر الأمان
}

model Doctor {
  id              String          @id @default(uuid())
  user_id         String          @unique
  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  specialization  String
  bio             String?
  session_price   Float           @default(0.0)
  certificate_url String?         // تمت الإضافة: إثبات الهوية/الشهادة للمراجعة
  is_verified     Boolean         @default(false)
  avg_rating      Float           @default(0.0)

  // Relations
  working_hours   WorkingHours[]
  appointments    Appointment[]
  reviews         Review[]
  clinical_notes  ClinicalNote[]
}

model Patient {
  id                String             @id @default(uuid())
  user_id           String             @unique
  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  date_of_birth     DateTime?
  gender            String?
  emergency_contact String?

  // Relations
  appointments      Appointment[]
  reviews           Review[]
  clinical_notes    ClinicalNote[]
  mood_entries      MoodEntry[]
  journals          Journal[]
  caregivers        CaregiverPatient[]
}

model CaregiverPatient {
  id                String          @id @default(uuid())
  caregiver_id      String
  patient_id        String
  patient           Patient         @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  consent_scope     String
  status            CaregiverStatus @default(PENDING)
  granted_at        DateTime?
  revoked_at        DateTime?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  @@unique([caregiver_id, patient_id])
}

model WorkingHours {
  id          String   @id @default(uuid())
  doctor_id   String
  doctor      Doctor   @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  day_of_week String
  start_time  String
  end_time    String
}

model Appointment {
  id            String            @id @default(uuid())
  patient_id    String
  patient       Patient           @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor_id     String
  doctor        Doctor            @relation(fields: [doctor_id], references: [id], onDelete: Cascade)
  date          DateTime
  start_time    String
  end_time      String
  status        AppointmentStatus @default(PENDING)
  meeting_link  String?
  recording_url String?           // تمت الإضافة: رابط تسجيل الجلسة (اختياري)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  // Relations
  review        Review?
  clinical_note ClinicalNote?
}

model ClinicalNote {
  id             String      @id @default(uuid())
  appointment_id String      @unique
  appointment    Appointment @relation(fields: [appointment_id], references: [id])
  doctor_id      String
  doctor         Doctor      @relation(fields: [doctor_id], references: [id])
  patient_id     String
  patient        Patient     @relation(fields: [patient_id], references: [id])
  diagnosis      String?
  treatment_plan String?
  notes          String?
  created_at     DateTime    @default(now())
}

model Review {
  id             String      @id @default(uuid())
  appointment_id String      @unique
  appointment    Appointment @relation(fields: [appointment_id], references: [id])
  patient_id     String
  patient        Patient     @relation(fields: [patient_id], references: [id])
  doctor_id      String
  doctor         Doctor      @relation(fields: [doctor_id], references: [id])
  rating         Int
  comment        String?
  created_at     DateTime    @default(now())
}

model MoodEntry {
  id         String   @id @default(uuid())
  patient_id String
  patient    Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  mood_score Int
  note       String?
  logged_at  DateTime @default(now())
}

model Journal {
  id          String   @id @default(uuid())
  patient_id  String
  patient     Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  content     String
  ai_feedback String?
  created_at  DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  content    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
}

model SafeCircle {
  id          String              @id @default(uuid())
  name        String
  description String?
  created_at  DateTime            @default(now())
  
  // Relations
  messages    SafeCircleMessage[]
  members     SafeCircleMember[]  // تمت الإضافة: ربط الدائرة بأعضائها
}

// تمت الإضافة: جدول عضوية دوائر الأمان
model SafeCircleMember {
  id         String     @id @default(uuid())
  user_id    String
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  circle_id  String
  circle     SafeCircle @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  role       CircleRole @default(MEMBER) // Admin أو Member
  joined_at  DateTime   @default(now())

  @@unique([user_id, circle_id])
}

model SafeCircleMessage {
  id         String     @id @default(uuid())
  circle_id  String
  circle     SafeCircle @relation(fields: [circle_id], references: [id], onDelete: Cascade)
  sender_id  String
  sender     User       @relation(fields: [sender_id], references: [id], onDelete: Cascade)
  content    String
  created_at DateTime   @default(now())
}